# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=eventler

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Application
PORT=3000
NODE_ENV=development

# Google Gemini API configuration
GOOGLE_API_KEY=your-google-api-key-here

# Google Places API configuration
# Optional: enables real venue/photo recommendations through Google Places.
# Leave empty to use Gemini-only recommendation generation.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_MS=8000

# Optional: choose Gemini model
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# Langfuse Configuration
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=0.0.1

# LLM-as-a-Judge Evaluation (optional, disabled by default)
# Enabling this adds an extra model call per recommendation generation.
RECOMMENDATION_JUDGE_ENABLED=false
RECOMMENDATION_JUDGE_MODEL=
RECOMMENDATION_JUDGE_TIMEOUT_MS=15000
RECOMMENDATION_JUDGE_SAMPLE_RATE=1
RECOMMENDATION_JUDGE_MAX_INPUT_LENGTH=4000
RECOMMENDATION_JUDGE_MAX_OUTPUT_LENGTH=2000

LANGFUSE_PROMPT_NAME=event-recommendation-planner
LANGFUSE_PROMPT_LABEL=development
